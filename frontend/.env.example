# Copy to frontend/.env.local. EVERYTHING here is baked into the public
# bundle at build time -- never put a secret in a VITE_ var.
VITE_API_BASE_URL=http://localhost:8000
VITE_MERCHANT_API_KEY=dev-merchant-key
# Razorpay key_id is publishable by design. key_secret is NOT and lives on Railway.
VITE_RAZORPAY_KEY_ID=
