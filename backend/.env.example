# Copy to backend/.env and fill in. NEVER commit the filled version.
APP_ENV=local
DEMO_MODE=true

# Comma-separated. The *.vercel.app regex is applied on top of these.
BACKEND_CORS_ORIGINS=http://localhost:5173

# Local dev: direct asyncpg at the Docker Postgres (make db-reset).
# Leave BLANK in production so Supabase/PostgREST is used instead.
DATABASE_URL=postgresql://postgres:pw@127.0.0.1:55433/kirana

# Supabase -- service role key is server-side ONLY, never shipped to a browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared merchant console key (multi-tenant auth is out of scope)
MERCHANT_API_KEY=dev-merchant-key

# Razorpay TEST mode. KEY_SECRET signs the checkout callback;
# WEBHOOK_SECRET signs the webhook body. They are DIFFERENT values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PUBLIC_APP_BASE_URL=http://localhost:5173

# LLM. Ollama Cloud key: https://ollama.com/settings/keys
LLM_PRIMARY=ollama_cloud
LLM_FALLBACK=groq
LLM_FORCE_PROVIDER=
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
